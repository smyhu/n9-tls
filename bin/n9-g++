#!/bin/bash
# g++ wrapper (libstdc++ 4.4 headers from N9 SDK): only N9 sysroot headers/libs/crt files, no host-toolchain glibc
TLS=$(cd "$(dirname "$0")/.." && pwd); S=$TLS/sysroot; G=arm-linux-gnueabihf-g++
GI=$($G -print-file-name=include)
link=1; for a in "$@"; do case "$a" in -c|-S|-E|-M|-MM) link=0;; esac; done
args=(-nostdinc -nostdinc++ -isystem "$S/usr/include/c++/4.4" -isystem "$S/usr/include/c++/4.4/arm-linux-gnueabi" -isystem "$S/usr/include/c++/4.4/backward" -isystem "$GI" -isystem "$S/usr/include"
 -march=armv7-a -mtune=cortex-a8 -mfpu=neon -mfloat-abi=hard -mthumb
 -fno-stack-protector -U_FORTIFY_SOURCE -fno-stack-clash-protection -fcf-protection=none -fno-pie -fcommon -std=gnu++98 -fabi-version=2 -fpermissive -Wno-narrowing -fno-delete-null-pointer-checks -fno-strict-aliasing -fno-lifetime-dse)
[ $link = 1 ] && args+=(-no-pie -B"$S/usr/lib/" -L"$S/lib" -L"$S/usr/lib" -L"$S/usr/lib/gcc/arm-linux-gnueabi/4.4" --sysroot="$S"
 -Wl,--dynamic-linker=/lib/ld-linux.so.3 -Wl,--hash-style=both -Wl,-z,norelro -Wl,-rpath-link,"$S/lib:$S/usr/lib")
exec $G "${args[@]}" "$@"
